# Wattwise — environment variables
# Copy to .env and adjust before first run.
# Most settings can also be configured via the in-app onboarding wizard.

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=9521

# ── DATABASE ──────────────────────────────────────────────────────────────────
DB_PATH=/app/data/wattwise.db

# ── BACKUPS ───────────────────────────────────────────────────────────────────
# Directory where automated backups are written.
# If using a NAS/network mount, ensure it is mounted before starting the container.
# The scheduler skips backup silently if the directory is unreachable.
BACKUP_DIR=/app/backups

# ── TIMEZONE ──────────────────────────────────────────────────────────────────
# IANA timezone string for the container. Use your local timezone.
# Examples: America/New_York  America/Los_Angeles  Europe/London  Australia/Sydney
TZ=UTC

# ── DATA CUTOFF DATES (optional — advanced users only) ────────────────────────
# These are normally set via the first-run onboarding wizard in the UI.
# Only set these here if you want to override the wizard values at the env level.
#
# CONS_START — date consumption data became reliable (e.g. system install date)
# PROD_START — date solar production became fully valid (e.g. grid export enabled)
# NET_START  — earliest date shown by default in dashboard charts
#
# Format: YYYY-MM-DD
# CONS_START=
# PROD_START=
# NET_START=

# ── DEBUG ─────────────────────────────────────────────────────────────────────
DEBUG=false
PYTHONUNBUFFERED=1
